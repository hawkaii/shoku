# Copy to .env and fill in. Never commit .env.
# All settings use the SHOKU_ prefix.

# Auth: "dev" trusts an X-Firebase-Uid header (never expose that publicly).
# "firebase" refuses to serve until token verification is implemented.
SHOKU_AUTH_MODE=dev

SHOKU_ENVIRONMENT=dev
# SQLite locally; Postgres in docker-compose / production.
SHOKU_DATABASE_URL=sqlite:///./shoku.db
# SHOKU_DATABASE_URL=postgresql+psycopg://shoku:shoku@localhost:5432/shoku

# "memory" only works for a single process (dev + tests).
SHOKU_QUEUE_BACKEND=memory
SHOKU_REDIS_URL=redis://localhost:6379/0
SHOKU_IMPORT_QUEUE_NAME=shoku:imports

# Storage: "dev" returns a non-uploadable placeholder URL. "r2" needs all four
# values below plus the public base URL.
SHOKU_STORAGE_BACKEND=dev
SHOKU_STORAGE_BUCKET=shoku-media
SHOKU_STORAGE_PUBLIC_BASE_URL=https://media.example.invalid
SHOKU_R2_ACCOUNT_ID=
SHOKU_R2_ACCESS_KEY_ID=
SHOKU_R2_SECRET_ACCESS_KEY=
SHOKU_PRESIGN_EXPIRES_SECONDS=900

# Pipeline. The budget can be shortened, never raised past 60s.
SHOKU_IMPORT_BUDGET_SECONDS=60
SHOKU_BREAKER_WINDOW=20
SHOKU_BREAKER_THRESHOLD=0.6
SHOKU_BREAKER_MIN_SAMPLES=5
# Empty means the system temp dir.
SHOKU_MEDIA_TMP_DIR=

# Assistant.
SHOKU_ASSISTANT_DAILY_CAP=20

# Sync.
SHOKU_SYNC_PAGE_SIZE=500
SHOKU_SYNC_MAX_PAGE_SIZE=1000
SHOKU_CLOCK_SKEW_ALLOWANCE_SECONDS=300
