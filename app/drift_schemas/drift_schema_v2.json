  "fixed_sql": [
    {
      "name": "dish_rows",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"dish_rows\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"subtitle\" TEXT NOT NULL DEFAULT '', \"cover_url\" TEXT NOT NULL DEFAULT '', \"source_handle\" TEXT NOT NULL DEFAULT '', \"status\" TEXT NOT NULL, \"minutes\" INTEGER NOT NULL DEFAULT 0, \"baseline_kcal\" INTEGER NOT NULL DEFAULT 0, \"baseline_protein\" INTEGER NOT NULL DEFAULT 0, \"steps\" TEXT NOT NULL DEFAULT '[]', \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"dirty\" INTEGER NOT NULL DEFAULT 1, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "version_rows",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"version_rows\" (\"id\" TEXT NOT NULL, \"dish_id\" TEXT NOT NULL REFERENCES dish_rows (id), \"number\" INTEGER NOT NULL DEFAULT 0, \"changes\" TEXT NOT NULL DEFAULT '[]', \"ingredients\" TEXT NOT NULL DEFAULT '[]', \"steps\" TEXT NOT NULL DEFAULT '[]', \"kcal\" INTEGER NOT NULL DEFAULT 0, \"protein\" INTEGER NOT NULL DEFAULT 0, \"origin_kind\" TEXT NOT NULL DEFAULT 'mine', \"origin_creator\" TEXT NULL, \"origin_url\" TEXT NULL, \"origin_shortcode\" TEXT NULL, \"parent_version_id\" TEXT NULL, \"extraction_version\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL, \"dirty\" INTEGER NOT NULL DEFAULT 1, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "cook_log_rows",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"cook_log_rows\" (\"id\" TEXT NOT NULL, \"dish_id\" TEXT NOT NULL REFERENCES dish_rows (id), \"version_id\" TEXT NULL, \"version_number\" INTEGER NOT NULL, \"cooked_at\" INTEGER NOT NULL, \"photo_url\" TEXT NOT NULL DEFAULT '', \"photo_state\" TEXT NOT NULL DEFAULT 'none', \"outcome\" TEXT NOT NULL, \"mood\" TEXT NOT NULL, \"note\" TEXT NOT NULL DEFAULT '', \"changes\" TEXT NOT NULL DEFAULT '[]', \"rating\" INTEGER NOT NULL DEFAULT 3, \"dirty\" INTEGER NOT NULL DEFAULT 1, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "meta_rows",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"meta_rows\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
